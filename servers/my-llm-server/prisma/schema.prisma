// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String // customer | agent
  createdAt    DateTime @default(now())

  sessions         Session[]
  tickets          Ticket[]   @relation("TicketOwner")
  assignedTickets  Ticket[]   @relation("TicketAssignee")
  auditLogs        AuditLog[]
}

model Session {
  id        String    @id @default(cuid())
  title     String
  kind      String    @default("customer-service")
  intent    String?
  userId    String?
  botPaused Boolean   @default(false)
  handoffAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages Message[]
  tickets  Ticket[]

  @@index([kind])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | assistant | agent
  content   String
  metadata  String? // JSON: intent, citations, grounded
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String
  intent      String // presale | aftersale | complaint | other
  status      String   @default("open") // open | in_progress | closed
  sessionId   String?
  userId      String?
  assigneeId  String?
  kbId        String   @default("customer-service")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session  Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user     User?    @relation("TicketOwner", fields: [userId], references: [id], onDelete: SetNull)
  assignee User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([assigneeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  detail    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
