DATABASE_URL=postgresql://postgres:password@localhost:5435/ai_langchain_db

# 必须是阿里云百炼控制台的 API-KEY，以 sk- 开头
# https://bailian.console.aliyun.com/?tab=model#/api-key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 登录签名密钥（生产必须改）
AUTH_SECRET=dev-only-change-me

# 客服作答模型（默认 qwen-flash，更快；需要更稳可改为 qwen3-max）
# CS_TEXT_MODEL=qwen-flash

# 可选：海外网络改用 intl embeddings 地址
# DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
